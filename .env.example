# ═══════════════════════════════════════════════════════════════════════════════
# ENVIRONMENT CONFIGURATION TEMPLATE
#
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control!
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE CONFIGURATION
# Get these from: https://app.supabase.com/project/_/settings/api
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ⚠️ SERVICE ROLE KEY - NEVER expose to client! Server-only!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT_NAME=School Management Platform

# Default timezone for all organizations (can be overridden per org)
DEFAULT_TIMEZONE=Asia/Karachi

# Default currency code (ISO 4217)
DEFAULT_CURRENCY=PKR


# ─────────────────────────────────────────────────────────────────────────────
# SUPER ADMIN SEED (for initial setup only)
# Run: npm run seed-super-admin
# ─────────────────────────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeThisSecurePassword123!


# ─────────────────────────────────────────────────────────────────────────────
# EMAIL PROVIDER CONFIGURATION
# Choose one: smtp OR resend
# ─────────────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp

# Option 1: SMTP (Gmail, Outlook, custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
EMAIL_FROM=noreply@yourschool.com

# Option 2: Resend (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxxxxx


# ─────────────────────────────────────────────────────────────────────────────
# FIREBASE CLOUD MESSAGING (Push Notifications)
# Get these from: Firebase Console > Project Settings > General
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# VAPID Key for push notifications (Firebase Console > Cloud Messaging > Web Push certificates)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BPxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Service Account JSON (Base64 encoded)
# Get from: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Then run: cat serviceAccountKey.json | base64
FIREBASE_SERVICE_ACCOUNT_JSON=ewogICJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsCiAgInByb2plY3RfaWQiOiAi...


# ─────────────────────────────────────────────────────────────────────────────
# CRON JOB SECRET
# Generate a random secret: openssl rand -base64 32
# Used to authenticate scheduled jobs (subscription renewal, etc.)
# ─────────────────────────────────────────────────────────────────────────────
CRON_SECRET=your-random-secret-string-here


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: PAYMENT GATEWAY (Phase 9)
# Uncomment when implementing payment processing
# ─────────────────────────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: ERROR TRACKING (Production)
# ─────────────────────────────────────────────────────────────────────────────
# SENTRY_DSN=https://xxxxxxxxxxxx@sentry.io/xxxxxxxxxxxx
# SENTRY_AUTH_TOKEN=xxxxxxxxxxxx


# ─────────────────────────────────────────────────────────────────────────────
# DEVELOPMENT ONLY
# ─────────────────────────────────────────────────────────────────────────────
# Set to 'true' to enable debug logging
DEBUG=false

# Disable telemetry in development
NEXT_TELEMETRY_DISABLED=1
