# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
*.log

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - NEVER COMMIT SECRETS!
.env
.env*.local
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
Thumbs.db
.DS_Store

# Temporary files
temp/
tmp/
*.tmp
*.temp

# Build artifacts
build_output.txt
build.log

# Script logs
/scripts/*.log

# Backup files
*.backup
*.bak
supabase/migrations/*.backup

# PDF/SVG test outputs
/*.pdf
/*.svg
!public/**/*.svg

# Sensitive data
student_records.pdf
student_records.svg
temp_paths.txt
